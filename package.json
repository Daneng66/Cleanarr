{
	"name": "cleanarr",
	"version": "0.1.0",
	"description": "Smart media library cleanup and storage optimization for the *Arr ecosystem",
	"license": "MIT",
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc -p tsconfig.build.json && node scripts/copy-web.mjs",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@fastify/static": "^10.1.5",
		"better-sqlite3": "^12.11.1",
		"fastify": "^5.12.5",
		"pino": "^10.3.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^22.20.4",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vitest": "^5.0.3"
	}
}
