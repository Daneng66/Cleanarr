{
	"name": "cleanarr",
	"version": "0.1.0",
	"description": "Smart media library cleanup and storage optimization for the *Arr ecosystem",
	"license": "MIT",
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "pnpm run dev:api & pnpm run dev:web",
		"dev:api": "tsx watch src/index.ts",
		"build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
		"test": "vitest run",
		"dev:web": "vite --config web/vite.config.ts"
	},
	"dependencies": {
		"@fastify/static": "^10.1.5",
		"better-sqlite3": "^12.11.1",
		"fastify": "^5.12.5",
		"pino": "^10.3.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^22.20.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^5.2.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vite": "^7.3.7",
		"vitest": "^5.0.3"
	}
}
